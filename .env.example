# ==============================================================================
# ArkenERP - Environment Configuration Template
# Copy this file to .env and configure your real secrets.
# ==============================================================================

# Database Connection Strings (Docker Compose default ports: MySQL 3308, Postgres 5433)
CONNECTIONSTRINGS__MANAGERDB=Server=127.0.0.1;Port=3308;Database=arken_manage;User=arken_user;Password=your_mysql_password;
CONNECTIONSTRINGS__RUNTIMEDB=Host=127.0.0.1;Port=5433;Database=arken_runtime;Username=arken_user;Password=your_postgres_password;

# JWT Security
JWT__KEY=YourSuperSecretKeyWithAtLeast32CharactersLong!
JWT__ISSUER=ArkenERP
JWT__AUDIENCE=ArkenERPClient

# AI Search & Providers
TAVILYSEARCHER__ENDPOINT=https://api.tavily.com/search
TAVILYSEARCHER__APIKEY=your_tavily_api_key_here

PROVIDERS__GOOGLE__ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/
PROVIDERS__GOOGLE__APIKEY=your_google_ai_key_here

PROVIDERS__OPENROUTER__ENDPOINT=https://openrouter.ai/api/v1
PROVIDERS__OPENROUTER__APIKEY=your_openrouter_api_key_here

PROVIDERS__DATABRICKS__ENDPOINT=https://your-databricks-instance.cloud.databricks.com
PROVIDERS__DATABRICKS__APIKEY=your_databricks_token_here
